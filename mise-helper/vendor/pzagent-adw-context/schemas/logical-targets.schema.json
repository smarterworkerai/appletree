{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "environment": {
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "targets": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "active",
              "shadow"
            ]
          },
          "provider": {
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "mode"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "environment",
    "targets"
  ],
  "type": "object"
}

# Private operator inputs: the maintainer copies this to .env.deploy in the checkout
# root (mode 0600) and fills it before any operator task. Never commit it; never
# use another consumer's credentials.
# Human-mode tasks read supported credential keys automatically.
DOKPLOY_URL=
DOKPLOY_API_KEY=
GITHUB_TOKEN=
# Optional registry credential and approved SSH alias:
REGISTRY_TOKEN=
PZ_ADW_SSH_ALIAS=
# Export probe origins explicitly; automatic credential loading does not import them.
APPLETREE_PREVIEW_URL=
APPLETREE_DEMO_URL=
APPLETREE_PRODUCTION_URL=

# KEYS ONLY - generated by `mise run pz:secrets:examples` from the committed adapter
# and key schemas; `mise run pz:secrets:examples:check` (CI) keeps it current.
# Nobody fills this file and no task reads it: every value comes from pz-secretctl
# (the agent vault). Recipes: references/secrets.md of the pzagent-adw-context skill.

# Operator credentials of the ADW tasks (shared vault IDs = these names).
DOKPLOY_API_KEY=                              # Dokploy API key
DOKPLOY_URL=                                  # Dokploy manager URL
GITHUB_TOKEN=                                 # releases, promotion and registry readback
REGISTRY_TOKEN=                               # optional separate registry publication token

# Probe URL templates, {app} = appletree (literal probes.base_url bindings need none).
DOKPLOY_DEMO_URL=                             # shared vault ID
DOKPLOY_PRODUCTION_URL=                       # shared vault ID
DOKPLOY_PR_PREVIEW_URL=                       # shared vault ID
